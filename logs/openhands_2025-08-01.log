    os.environ["AWS_DEFAULT_REGION"] = "us-east-1"
    yield

@pytest.fixture
def ts_client(aws_credentials):
    with mock_timestreamwrite():
        conn = boto3.client("timestream-write")
        yield conn

@pytest.fixture
